# ── Required ────────────────────────────────────────────────
TELEGRAM_TOKEN=your_telegram_bot_token_here
ORCAROUTER_API_KEY=your_orcarouter_api_key_here

# ── Redis ───────────────────────────────────────────────────
# Local: redis://localhost:6379
# Railway: set automatically when you add the Redis plugin
REDIS_URL=redis://localhost:6379

# ── Webhook (production only) ────────────────────────────────
# WEBHOOK_URL=https://your-app.up.railway.app
# WEBHOOK_SECRET=change-me-to-a-random-string

# ── AI settings ──────────────────────────────────────────────
# Options: deepseek/deepseek-v4-pro-free | deepseek/deepseek-v4-flash-free | qwen/qwen3.8-27b-free
AI_MODEL=deepseek/deepseek-v4-pro-free
AI_SYSTEM_PROMPT=You are a helpful, concise, and friendly AI assistant.
AI_MAX_TOKENS=1024

# ── Tuning ────────────────────────────────────────────────────
HISTORY_MAX_MESSAGES=20
HISTORY_TTL_HOURS=24
RATE_LIMIT_PER_MINUTE=10

# ── Server ────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
WORKER_COUNT=4
